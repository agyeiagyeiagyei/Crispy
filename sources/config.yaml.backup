sources:
  - Crispy.glyphs
familyName: Crispy
buildStatic: false
spacingAxis:
  min: -20
  max: 100
fvarInstances:
  Crispy[SPAC,XOPQ,XTRA,YOPQ].ttf:
  - name: ExtraLight
    coordinates:
      wght: 200
      wdth: 100
      opsz: 12
  - name: Light
    coordinates:
      wght: 300
      wdth: 100
      opsz: 12
  - name: Regular
    coordinates:
      wght: 400
      wdth: 100
      opsz: 12
  - name: Medium
    coordinates:
      wght: 500
      wdth: 100
      opsz: 12
  - name: SemiBold
    coordinates:
      wght: 600
      wdth: 100
      opsz: 12
  - name: Bold
    coordinates:
      wght: 700
      wdth: 100
      opsz: 12
  - name: ExtraBold
    coordinates:
      wght: 800
      wdth: 100
      opsz: 12
  - name: Black
    coordinates:
      wght: 900
      wdth: 100
      opsz: 12
stat:
  Crispy[SPAC,XOPQ,XTRA,YOPQ].ttf:
  - name: Optical Size
    tag: opsz
    values:
    - name: 12pt
      value: 12
    - name: 72pt
      value: 72
  - name: Width
    tag: wdth
    values:
    - name: Condensed
      value: 40
    - name: Normal
      value: 100
    - name: Extended
      value: 160
    - name: Ultra Extended
      value: 220
  - name: Weight
    tag: wght
    values:
    - name: ExtraLight
      value: 200
    - name: Light
      value: 300
    - name: Regular
      value: 400
      linkedValue: 700
      flags: 2
    - name: Medium
      value: 500
    - name: SemiBold
      value: 600
    - name: Bold
      value: 700
    - name: ExtraBold
      value: 800
    - name: Black
      value: 900

